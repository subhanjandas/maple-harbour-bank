  "rules": [
    {
      "id": "R25",
      "entities": [
        "payment_order",
        "account",
        "beneficiary"
      ],
      "category": "conditional",
      "statement": "An INTERNAL order has a non-null destination account, a null beneficiary and different source/destination accounts. An OUTBOUND order has a beneficiary and no destination account. Both accounts are deposits and currency matches the order; the initiating authority must be checked separately.",
      "enforcement_plan": "dataset_validation",
      "implementation_status": "specified_not_implemented"
    },
    {
      "id": "R26",
      "entities": [
        "payment_order",
        "payment_event",
        "account_entry"
      ],
      "category": "reconciliation",
      "statement": "Each POSTED or SETTLED internal order has exactly one DEPOSIT_PAYMENT debit on the source and one equal credit on the destination. An outbound order has exactly one source debit. Entries match amount and currency. FAILED or CANCELLED orders have no unreversed posting in this simplified version.",
      "enforcement_plan": "dataset_validation",
      "implementation_status": "specified_not_implemented"
    },
    {
      "id": "R27",
      "entities": [
        "payment_settlement",
        "payment_order",
        "payment_event"
      ],
      "category": "reconciliation",
      "statement": "Settlement belongs only to an OUTBOUND order. There is one full settlement per order with equal amount and currency. SETTLED requires a settlement observation; internal orders finish at POSTED.",
      "enforcement_plan": "dataset_validation",
      "implementation_status": "specified_not_implemented"
    },
    {
      "id": "R34",
      "entities": [
        "journal",
        "journal_line"
      ],
      "category": "aggregate",
      "statement": "Each POSTED journal contains at least two strictly positive lines and equal total debits and credits, in its one declared currency and legal entity. A DRAFT journal may be incomplete.",
      "enforcement_plan": "dataset_validation",
      "implementation_status": "specified_not_implemented"
    },
    {
      "id": "R35",
      "entities": [
        "posting_link",
        "account_entry",
        "journal_line",
        "journal",
        "account"
      ],
      "category": "reconciliation",
      "statement": "Allocated amounts are positive. For entries included in an ACCOUNT_TO_GL reconciliation, allocations must total the entry amount. Linked line direction and currency match the entry; allocations to one ledger line cannot exceed that line amount. Counterpart lines may be unmapped.",
      "enforcement_plan": "dataset_validation",
      "implementation_status": "specified_not_implemented"
    },
    {
      "id": "R39",
      "entities": [
        "payment_order",
        "payment_event",
        "account_entry"
      ],
      "category": "cross_row",
      "statement": "Full internal reversals preserve original entries and append one equal opposite entry per original entry on the same account. Outbound returns use payment_return installments and new PAYMENT_RETURN credits; partial and full returned totals are reconciled separately.",
      "enforcement_plan": "dataset_validation",
      "implementation_status": "specified_not_implemented"
    },
    {
      "id": "R40",
      "entities": [
        "payment_event",
        "account_status_event",
        "card_status_event"
